rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function platformPath(){return /databases/$(database)/documents/platformAdmins/$(request.auth.uid);}
  function staffPath(){return /databases/$(database)/documents/platformStaff/$(request.auth.uid);}
  function owner(){return signedIn() && exists(platformPath()) && get(platformPath()).data.active == true;}
  function staffRole(){return signedIn() && exists(staffPath()) && get(staffPath()).data.active == true ? get(staffPath()).data.role : 'none';}
  function platform(){return owner() || staffRole() == 'administrator';}
  function platformOps(){return platform() || staffRole() == 'payroll_operator';}
  function platformView(){return platformOps() || staffRole() == 'support';}
  // Only Sterling's central team may administer agreements, invoices and support cases.
  function sterlingSupport(){return platform() || staffRole() == 'support';}
  function clientHelpDesk(t){return member(t) && role(t) != 'employee';}
  function canSeeTicket(t,createdBy){return sterlingSupport() ||
    (clientHelpDesk(t) && createdBy == request.auth.uid);}
  function memberPath(t){return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid);}
  function member(t){return signedIn() && exists(memberPath(t)) && get(memberPath(t)).data.status == 'active' &&
    get(/databases/$(database)/documents/tenants/$(t)).data.status == 'active';}
  function role(t){return get(memberPath(t)).data.role;}
  function clientAdmin(t){return platform() || (member(t) && role(t) == 'client_admin');}
  function payrollStaff(t){return platformOps() || clientAdmin(t) || (member(t) && role(t) == 'payroll_specialist');}
  // Legacy runs without processingMode continue to use combined earnings.
  function runMode(t,r){return get(runPath(t,r)).data.get('processingMode','combined');}
  function validModeLine(t,r){
   return (runMode(t,r) != 'timecards-only' ||
     request.resource.data.get('commissionCents',0) == 0) &&
    (runMode(t,r) != 'commissions-only' ||
     (request.resource.data.regularCents == 0 &&
      request.resource.data.overtimeCents == 0 &&
      request.resource.data.bonusCents == 0 &&
      request.resource.data.regularHours == 0 &&
      request.resource.data.overtimeHours == 0 &&
      request.resource.data.get('paidLeaveHours',0) == 0));
  }
  function clientView(t){return platformView() || (member(t) && role(t) != 'employee');}
  function employeeLinkPath(t){return /databases/$(database)/documents/tenants/$(t)/employeeLinks/$(request.auth.uid);}
  function employeeLinked(t){return member(t) && exists(employeeLinkPath(t));}
  function ownsEmployee(t,e){return employeeLinked(t) && get(employeeLinkPath(t)).data.employeeId == e;}
  function text(v,n){return v is string && v.size() > 0 && v.size() <= n;}
  function cent(v){return v is int && v >= 0 && v <= 1000000000;}
  function hours(v){return v is number && v >= 0 && v <= 744;}
  function date(v){return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');}
  function employeePath(t,e){return /databases/$(database)/documents/tenants/$(t)/employees/$(e);}
  function runPath(t,r){return /databases/$(database)/documents/tenants/$(t)/payrollRuns/$(r);}
  function revisionPath(t,r,id){return /databases/$(database)/documents/tenants/$(t)/payrollRuns/$(r)/revisions/$(id);}
  function validRevision(t,r,kind,entityId){
   return owner() && request.resource.data.get('lastRevisionId','') is string &&
    request.resource.data.get('lastRevisionId','').size() > 0 &&
    existsAfter(revisionPath(t,r,request.resource.data.lastRevisionId)) &&
    getAfter(revisionPath(t,r,request.resource.data.lastRevisionId)).data.actor == request.auth.uid &&
    getAfter(revisionPath(t,r,request.resource.data.lastRevisionId)).data.kind == kind &&
    getAfter(revisionPath(t,r,request.resource.data.lastRevisionId)).data.entityId == entityId &&
    getAfter(revisionPath(t,r,request.resource.data.lastRevisionId)).data.before == resource.data &&
    getAfter(revisionPath(t,r,request.resource.data.lastRevisionId)).data.after == request.resource.data;
  }

  // Existing owner privileges remain unchanged. No automatic owner claim on registration.
  match /platformAdmins/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || owner());
   allow list: if owner();
   allow write: if false;
  }
  // Self-registered directory entries contain no elevated permissions.
  match /accounts/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || owner() || platform());
   allow list: if owner() || platform();
   allow create: if signedIn() && request.auth.uid == uid &&
    request.resource.data.keys().hasOnly(['email','displayName','accountType','createdAt']) &&
    request.resource.data.email == request.auth.token.email &&
    request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
    request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120 &&
    request.resource.data.accountType == 'client';
   allow update: if signedIn() && request.auth.uid == uid &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) &&
    request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120;
   allow delete: if false;
  }
  // Only the existing platform owner can elevate registered identities into staff.
  match /platformStaff/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || owner());
   allow list: if owner();
   allow create: if owner() && exists(/databases/$(database)/documents/accounts/$(uid)) &&
    request.resource.data.keys().hasOnly(['role','active','grantedBy','updatedAt']) &&
    request.resource.data.role in ['administrator','payroll_operator','support'] &&
    request.resource.data.active == true && request.resource.data.grantedBy == request.auth.uid;
   allow update: if owner() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','active','updatedAt']) &&
    request.resource.data.role in ['administrator','payroll_operator','support'] &&
    request.resource.data.active is bool &&
    request.resource.data.grantedBy == resource.data.grantedBy;
   allow delete: if owner();
  }
  // Private per-user directory of accepted client workspaces; never a permission grant by itself.
  match /deletionReceipts/{receiptId} {
   allow get,list: if owner();
   allow create: if owner() &&
    request.resource.data.keys().hasOnly(['kind','tenantId','recordPath','actor','reason','status','planned','completed','createdAt','updatedAt']) &&
    request.resource.data.actor == request.auth.uid &&
    request.resource.data.status == 'running' &&
    request.resource.data.reason is string &&
    request.resource.data.reason.size() >= 10 &&
    request.resource.data.reason.size() <= 500 &&
    request.resource.data.kind is string &&
    request.resource.data.tenantId is string &&
    request.resource.data.recordPath is string &&
    request.resource.data.planned is int &&
    request.resource.data.planned >= 1 && request.resource.data.planned <= 15000 &&
    request.resource.data.completed == 0 &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.updatedAt == request.time;
   allow update: if owner() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completed','updatedAt']) &&
    resource.data.actor == request.auth.uid &&
    resource.data.status in ['running','interrupted'] &&
    request.resource.data.status in ['running','interrupted','completed'] &&
    request.resource.data.completed is int &&
    request.resource.data.completed >= resource.data.completed &&
    request.resource.data.completed <= resource.data.planned &&
    request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Parent documents are occasionally absent while individual employee threads exist.
  // Never grant client-wide enumeration of another employee's messages.
  match /userTenants/{uid}/items/{t} {
   allow get,list: if signedIn() && (request.auth.uid == uid || platform());
   allow create: if platform() &&
    existsAfter(/databases/$(database)/documents/tenants/$(t)/members/$(uid)) &&
    request.resource.data.keys().hasOnly(['tenantId','joinedAt']) &&
    request.resource.data.tenantId == t;
   allow delete: if platform();
   allow update: if false;
  }
  match /tenants/{t} {
   allow get: if clientView(t) || member(t);
   allow list: if clientView(t);
   allow create: if platform() &&
    request.resource.data.keys().hasOnly(['name','status','createdAt','createdBy','contactEmail','servicePlan','industry','notes']) &&
    text(request.resource.data.name,120) &&
    request.resource.data.status == 'active' &&
    request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 254 &&
    request.resource.data.servicePlan in ['starter','standard','enterprise'] &&
    request.resource.data.industry is string && request.resource.data.industry.size() <= 100 &&
    request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
    request.resource.data.createdBy == request.auth.uid;
   allow update: if platform() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','contactEmail','servicePlan','industry','notes']) &&
    text(request.resource.data.name,120) &&
    request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 254 &&
    request.resource.data.servicePlan in ['starter','standard','enterprise'] &&
    request.resource.data.industry is string && request.resource.data.industry.size() <= 100 &&
    request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
    request.resource.data.status in ['active','suspended'];
   allow delete: if owner();

   match /invites/{email} {
    allow get: if clientAdmin(t);
    allow list: if clientAdmin(t);
    allow create: if platform() &&
      request.resource.data.keys().hasOnly(['email','role','createdBy','createdAt']) &&
      request.resource.data.email == email &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.role in ['client_admin','payroll_specialist','viewer','employee'] &&
      request.resource.data.createdBy == request.auth.uid;
    allow update: if platform() &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
     request.resource.data.email == resource.data.email &&
     request.resource.data.role in ['client_admin','payroll_specialist','viewer','employee'];
   allow delete: if platform();
   }

   match /members/{uid} {
    allow get: if platform() || (signedIn() && request.auth.uid == uid) || clientAdmin(t);
    allow list: if clientAdmin(t);
    // Users only accept invitations addressed to their verified email.
    allow create: if platform() &&
      exists(/databases/$(database)/documents/accounts/$(uid)) &&
      request.resource.data.keys().hasOnly(['email','role','status','joinedAt']) &&
      request.resource.data.email == get(/databases/$(database)/documents/accounts/$(uid)).data.email &&
      request.resource.data.role in ['client_admin','payroll_specialist','viewer','employee'] &&
      request.resource.data.status == 'active';
    allow update: if platform() && uid != request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status']) &&
      request.resource.data.role in ['client_admin','payroll_specialist','viewer','employee'] &&
      request.resource.data.status in ['active','suspended'] &&
      resource.data.email == request.resource.data.email;
    allow delete: if owner();
   }

   // Explicit employer-approved identity binding. A registered email alone grants no access.
   match /employeeLinks/{uid} {
    allow get: if clientAdmin(t) || (signedIn() && request.auth.uid == uid && member(t));
    allow list: if clientAdmin(t);
    allow create, update: if platform() &&
      exists(/databases/$(database)/documents/accounts/$(uid)) &&
      exists(/databases/$(database)/documents/tenants/$(t)/members/$(uid)) &&
      get(/databases/$(database)/documents/tenants/$(t)/members/$(uid)).data.status == 'active' &&
      request.resource.data.keys().hasOnly(['employeeId','linkedBy','linkedAt']) &&
      text(request.resource.data.employeeId,128) &&
      exists(employeePath(t,request.resource.data.employeeId)) &&
      request.resource.data.linkedBy == request.auth.uid;
    allow delete: if platform();
   }
   // Self-service preferences never change HR payroll source fields.
   match /employeePreferences/{uid} {
    allow get: if clientAdmin(t) || (signedIn() && request.auth.uid == uid && employeeLinked(t));
    allow list: if clientAdmin(t);
    allow create, update: if signedIn() && request.auth.uid == uid && employeeLinked(t) &&
     request.resource.data.keys().hasOnly(['preferredName','notifications','updatedAt']) &&
     request.resource.data.preferredName is string &&
     request.resource.data.preferredName.size() <= 80 &&
     request.resource.data.notifications is bool &&
     request.resource.data.updatedAt == request.time;
    allow delete: if owner();
   }
   // All announcements are visible to approved company members, never the public.
   match /announcements/{id} {
    allow get, list: if clientView(t) || employeeLinked(t);
    allow create: if clientAdmin(t) &&
     request.resource.data.keys().hasOnly(['title','body','createdAt','createdBy']) &&
     text(request.resource.data.title,100) &&
     text(request.resource.data.body,1800) &&
     request.resource.data.createdAt == request.time &&
     request.resource.data.createdBy == request.auth.uid;
    allow update: if false;
    allow delete: if owner();
   }
   match /employeeConversations/{uid} {
    allow get,list,delete: if owner();
    allow create,update: if false;
   }
   match /employeeRequests/{uid} {
    allow get,list,delete: if owner();
    allow create,update: if false;
   }
   // One employee-specific thread per approved account. No employee can enumerate another's thread.
   match /employeeConversations/{uid}/messages/{messageId} {
    allow get, list: if clientAdmin(t) || (signedIn() && request.auth.uid == uid && employeeLinked(t));
    allow create: if (clientAdmin(t) || (signedIn() && request.auth.uid == uid && employeeLinked(t))) &&
     request.resource.data.keys().hasOnly(['body','authorUid','authorRole','sentAt']) &&
     text(request.resource.data.body,1800) &&
     request.resource.data.authorUid == request.auth.uid &&
     request.resource.data.authorRole == (clientAdmin(t) ? 'employer' : 'employee') &&
     request.resource.data.sentAt == request.time &&
     exists(/databases/$(database)/documents/tenants/$(t)/employeeLinks/$(uid));
    allow update: if false;
    allow delete: if owner();
   }
   // Text-only fictional requests: no uploads, real IDs, or bank/tax data.
   match /employeeRequests/{uid}/items/{requestId} {
    allow get, list: if clientAdmin(t) || (signedIn() && request.auth.uid == uid && employeeLinked(t));
    allow create: if clientAdmin(t) &&
     exists(/databases/$(database)/documents/tenants/$(t)/employeeLinks/$(uid)) &&
     request.resource.data.keys().hasOnly(['title','instructions','dueDate','status','createdBy','createdAt','response','updatedAt']) &&
     text(request.resource.data.title,100) &&
     text(request.resource.data.instructions,800) &&
     request.resource.data.dueDate is string &&
     (request.resource.data.dueDate == '' || date(request.resource.data.dueDate)) &&
     request.resource.data.status == 'pending' &&
     request.resource.data.createdBy == request.auth.uid &&
     request.resource.data.response == '' &&
     request.resource.data.createdAt == request.time &&
     request.resource.data.updatedAt == request.time;
    allow update: if (
     (signedIn() && request.auth.uid == uid && employeeLinked(t) &&
      resource.data.status == 'pending' && request.resource.data.status == 'submitted' &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response','updatedAt']) &&
      request.resource.data.response is string && request.resource.data.response.size() <= 500 &&
      request.resource.data.updatedAt == request.time)
     ||
     (clientAdmin(t) && resource.data.status == 'submitted' &&
      request.resource.data.status in ['completed','pending'] &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
      request.resource.data.updatedAt == request.time)
     );
    allow delete: if owner();
   }
   // Owner operation records remain readable to the owner, but cannot be changed or removed.
   match /ownerAudit/{auditId} {
    allow read: if owner();
    allow create: if owner() &&
     request.resource.data.keys().hasOnly(['action','entityType','entityId','reason','actor','at','before']) &&
     text(request.resource.data.action,40) &&
     text(request.resource.data.entityType,80) &&
     text(request.resource.data.entityId,128) &&
     text(request.resource.data.reason,500) && request.resource.data.reason.size() >= 10 &&
     request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time &&
     request.resource.data.before is map;
    allow update: if false;
    allow delete: if owner();
   }
   // Append-only operational event feed. This is a client-action log, not a trusted
   // independently administered audit service; a privileged browser can still omit it.
   // Advisory-only retention policy. No automatic record deletion or real legal holds.
   match /assuranceSettings/current {
    allow read: if clientAdmin(t);
    allow create,update: if clientAdmin(t) &&
     request.resource.data.keys().hasOnly(['reviewAfterDays','legalHold','updatedBy','updatedAt']) &&
     request.resource.data.reviewAfterDays in [90,180,365,730,1825,3650] &&
     request.resource.data.legalHold is bool &&
     request.resource.data.updatedBy == request.auth.uid &&
     request.resource.data.updatedAt == request.time;
    allow delete: if owner();
   }
   match /auditEvents/{eventId} {
    allow read: if clientAdmin(t) || platformView();
    allow create: if (payrollStaff(t) || platformView()) &&
     request.resource.data.keys().hasOnly(['category','action','subject','detail','actor','at']) &&
     text(request.resource.data.category,50) &&
     text(request.resource.data.action,60) &&
     text(request.resource.data.subject,160) &&
     request.resource.data.detail is string && request.resource.data.detail.size() <= 300 &&
     request.resource.data.actor == request.auth.uid &&
     request.resource.data.at == request.time;
    allow update: if false;
    allow delete: if owner();
   }

   // Optional roleplay commissions. Disabled by default in each independent client workspace.
   match /commissionSettings/current {
    allow get,list: if payrollStaff(t);
    allow create,update: if clientAdmin(t) &&
     request.resource.data.keys().hasOnly(['enabled','updatedBy','updatedAt']) &&
     request.resource.data.enabled is bool &&
     request.resource.data.updatedBy == request.auth.uid &&
     request.resource.data.updatedAt == request.time;
    allow delete: if owner();
   }
   match /commissionPlans/{employeeId} {
    allow get,list: if payrollStaff(t);
    allow create,update: if clientAdmin(t) &&
     exists(employeePath(t,employeeId)) &&
     exists(/databases/$(database)/documents/tenants/$(t)/commissionSettings/current) &&
     get(/databases/$(database)/documents/tenants/$(t)/commissionSettings/current).data.enabled == true &&
     request.resource.data.keys().hasOnly(['employeeId','type','rateBasisPoints','fixedCents','active','updatedBy','updatedAt']) &&
     request.resource.data.employeeId == employeeId &&
     request.resource.data.type in ['percent','fixed'] &&
     request.resource.data.rateBasisPoints is int &&
     request.resource.data.rateBasisPoints >= 0 && request.resource.data.rateBasisPoints <= 10000 &&
     cent(request.resource.data.fixedCents) &&
     (request.resource.data.type == 'percent' ? request.resource.data.fixedCents == 0 : request.resource.data.rateBasisPoints == 0) &&
     request.resource.data.active is bool &&
     request.resource.data.updatedBy == request.auth.uid &&
     request.resource.data.updatedAt == request.time;
    allow delete: if owner();
   }
   match /commissionSales/{saleId} {
    allow get,list: if payrollStaff(t);
    allow create: if payrollStaff(t) &&
     exists(/databases/$(database)/documents/tenants/$(t)/commissionSettings/current) &&
     get(/databases/$(database)/documents/tenants/$(t)/commissionSettings/current).data.enabled == true &&
     request.resource.data.keys().hasOnly(['employeeId','saleDate','description','saleAmountCents',
      'commissionCents','type','rateBasisPoints','fixedCents','status','approvedBy','paidRunId','createdBy','createdAt']) &&
     request.resource.data.employeeId is string &&
     exists(employeePath(t,request.resource.data.employeeId)) &&
     exists(/databases/$(database)/documents/tenants/$(t)/commissionPlans/$(request.resource.data.employeeId)) &&
     get(/databases/$(database)/documents/tenants/$(t)/commissionPlans/$(request.resource.data.employeeId)).data.active == true &&
     request.resource.data.type == get(/databases/$(database)/documents/tenants/$(t)/commissionPlans/$(request.resource.data.employeeId)).data.type &&
     request.resource.data.rateBasisPoints == get(/databases/$(database)/documents/tenants/$(t)/commissionPlans/$(request.resource.data.employeeId)).data.rateBasisPoints &&
     request.resource.data.fixedCents == get(/databases/$(database)/documents/tenants/$(t)/commissionPlans/$(request.resource.data.employeeId)).data.fixedCents &&
     request.resource.data.type in ['percent','fixed'] &&
     date(request.resource.data.saleDate) && text(request.resource.data.description,160) &&
     request.resource.data.description.size() >= 3 &&
     cent(request.resource.data.saleAmountCents) && request.resource.data.saleAmountCents > 0 &&
     cent(request.resource.data.commissionCents) &&
     (request.resource.data.type == 'fixed' ?
      request.resource.data.commissionCents == request.resource.data.fixedCents :
      request.resource.data.commissionCents == math.round(request.resource.data.saleAmountCents * request.resource.data.rateBasisPoints / 10000)) &&
     request.resource.data.status == 'pending' &&
     request.resource.data.approvedBy == '' && request.resource.data.paidRunId == '' &&
     request.resource.data.createdBy == request.auth.uid &&
     request.resource.data.createdAt == request.time;
    allow update: if
     (clientAdmin(t) && resource.data.status == 'pending' &&
      (owner() || resource.data.createdBy != request.auth.uid) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedBy','reviewedAt']) &&
      request.resource.data.status in ['approved','rejected'] &&
      request.resource.data.approvedBy == request.auth.uid &&
      request.resource.data.reviewedAt == request.time)
     ||
     (payrollStaff(t) && resource.data.status == 'approved' &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidRunId']) &&
      request.resource.data.paidRunId is string &&
      (request.resource.data.paidRunId == '' ?
       (owner() || (resource.data.paidRunId != '' &&
        exists(runPath(t,resource.data.paidRunId)) &&
        get(runPath(t,resource.data.paidRunId)).data.status == 'draft')) :
       (resource.data.paidRunId == '' &&
        exists(runPath(t,request.resource.data.paidRunId)) &&
        get(runPath(t,request.resource.data.paidRunId)).data.status == 'draft')));
    allow delete: if owner();
   }
   match /serviceAgreements/current {
    allow read: if clientView(t);
    allow create,update: if platform() &&
     request.resource.data.keys().hasOnly(['tier','billingCycle','status','renewalDate','seatLimit','rateCents','updatedBy','updatedAt']) &&
     request.resource.data.tier in ['starter','standard','enterprise'] &&
     request.resource.data.billingCycle in ['monthly','annual'] &&
     request.resource.data.status in ['trial','active','paused','cancelled'] &&
     request.resource.data.renewalDate is string &&
     (request.resource.data.renewalDate == '' || date(request.resource.data.renewalDate)) &&
     request.resource.data.seatLimit is int && request.resource.data.seatLimit >= 0 && request.resource.data.seatLimit <= 100000 &&
     cent(request.resource.data.rateCents) &&
     request.resource.data.updatedBy == request.auth.uid &&
     request.resource.data.updatedAt == request.time;
    allow delete: if owner();
   }
   // All invoices and "payments" are explicitly fictional. Invoice state transitions
   // are enforced here. Ledger balance reconciliation is currently client-side only.
   match /billingInvoices/{invoiceId} {
    allow read: if clientView(t);
    allow create: if platform() &&
     request.resource.data.keys().hasOnly(['description','amountCents','dueDate','status','createdAt','updatedAt','createdBy']) &&
     text(request.resource.data.description,160) && cent(request.resource.data.amountCents) &&
     request.resource.data.amountCents > 0 &&
     request.resource.data.dueDate is string && (request.resource.data.dueDate == '' || date(request.resource.data.dueDate)) &&
     request.resource.data.status == 'draft' &&
     request.resource.data.createdBy == request.auth.uid &&
     request.resource.data.createdAt == request.time &&
     request.resource.data.updatedAt == request.time;
    allow update: if platform() &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
     (
       (resource.data.status == 'draft' && request.resource.data.status in ['issued','void']) ||
       (resource.data.status == 'issued' && request.resource.data.status in ['settled','void']) ||
       (resource.data.status == 'settled' && request.resource.data.status == 'issued')
     ) && request.resource.data.updatedAt == request.time;
    allow delete: if owner();
    match /events/{eventId} {
     allow read: if clientView(t);
     allow create: if platform() &&
      exists(/databases/$(database)/documents/tenants/$(t)/billingInvoices/$(invoiceId)) &&
      get(/databases/$(database)/documents/tenants/$(t)/billingInvoices/$(invoiceId)).data.status in ['draft','issued'] &&
      request.resource.data.keys().hasOnly(['type','amountCents','note','createdBy','createdAt']) &&
      request.resource.data.type in ['payment','credit','adjustment'] &&
      cent(request.resource.data.amountCents) && request.resource.data.amountCents > 0 &&
      text(request.resource.data.note,300) && request.resource.data.note.size() >= 6 &&
      request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
     allow update: if false;
     allow delete: if owner();
    }
   }
   // Client ticket queue, scoped public updates and separately private internal notes.
   match /supportTickets/{ticketId} {
    allow get,list: if canSeeTicket(t,resource.data.createdBy);
    allow create: if (sterlingSupport() || clientHelpDesk(t)) &&
     request.resource.data.keys().hasOnly(['subject','details','priority','category','status','assignedUid','createdBy','createdAt','updatedAt']) &&
     text(request.resource.data.subject,120) && text(request.resource.data.details,1500) &&
     (sterlingSupport() || request.resource.data.priority in ['low','normal','high']) &&
     request.resource.data.priority in ['low','normal','high','urgent'] &&
     request.resource.data.category in ['payroll','employee','billing','technical','general'] &&
     request.resource.data.status == 'open' && request.resource.data.assignedUid == '' &&
     request.resource.data.createdBy == request.auth.uid &&
     request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    allow update: if sterlingSupport() &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','assignedUid','updatedAt']) &&
     request.resource.data.status in ['open','in_progress','waiting_on_client','resolved','closed'] &&
     resource.data.status != 'closed' &&
     request.resource.data.assignedUid is string &&
     (request.resource.data.assignedUid == resource.data.get('assignedUid','') ||
      request.resource.data.assignedUid == '' ||
      (platform() && request.resource.data.assignedUid == request.auth.uid) ||
