     allow create: if (sterlingSupport() || (clientHelpDesk(t) &&
      canSeeTicket(t,get(/databases/$(database)/documents/tenants/$(t)/supportTickets/$(ticketId)).data.createdBy))) &&
      exists(/databases/$(database)/documents/tenants/$(t)/supportTickets/$(ticketId)) &&
