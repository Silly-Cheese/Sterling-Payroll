     text(request.resource.data.name,80) &&
     request.resource.data.cadence in ['weekly','biweekly','semimonthly','monthly'] &&
     request.resource.data.processingMode in ['combined','timecards-only','commissions-only'] &&
     date(request.resource.data.nextStart) &&
     request.resource.data.payDelay is int && request.resource.data.payDelay >= 0 && request.resource.data.payDelay <= 30 &&
     request.resource.data.active is bool &&
     request.resource.data.createdBy == request.auth.uid &&
     request.resource.data.createdAt == request.time &&
     request.resource.data.updatedAt == request.time;
    allow update: if payrollStaff(t) &&
