       hours(request.resource.data.regularHours) && hours(request.resource.data.overtimeHours) &&
       cent(request.resource.data.regularCents) && cent(request.resource.data.overtimeCents) &&
       cent(request.resource.data.bonusCents) && cent(request.resource.data.deductionCents) &&
       cent(request.resource.data.grossCents) && cent(request.resource.data.netCents) &&
       cent(request.resource.data.get('commissionCents',0)) &&
       request.resource.data.get('taxRateBasisPoints',0) is int &&
       request.resource.data.get('taxRateBasisPoints',0) >= 0 &&
       request.resource.data.get('taxRateBasisPoints',0) <= 10000 &&
       cent(request.resource.data.get('taxCents',0)) &&
       request.resource.data.get('taxCents',0) ==
        math.round(request.resource.data.grossCents * request.resource.data.get('taxRateBasisPoints',0) / 10000) &&
       cent(request.resource.data.get('otherDeductionCents',request.resource.data.deductionCents)) &&
       request.resource.data.get('otherDeductionCents',request.resource.data.deductionCents) +
        request.resource.data.get('taxCents',0) == request.resource.data.deductionCents &&
       request.resource.data.grossCents == request.resource.data.regularCents +
        request.resource.data.overtimeCents + request.resource.data.bonusCents +
        request.resource.data.get('commissionCents',0) &&
       request.resource.data.netCents == request.resource.data.grossCents - request.resource.data.deductionCents &&
       request.resource.data.get('policyVersion',1) is int &&
       request.resource.data.get('paidLeaveHours',0) is number &&
       request.resource.data.get('paidLeaveHours',0) >= 0 &&
       request.resource.data.get('paidLeaveHours',0) <= 744 && validModeLine(t,r);
     allow update: if (
      (payrollStaff(t) && exists(runPath(t,r)) && get(runPath(t,r)).data.status == 'draft' &&
       exists(employeePath(t,employeeId)) &&
       request.resource.data.employeeId == employeeId &&
       cent(request.resource.data.regularCents) && cent(request.resource.data.overtimeCents) &&
       cent(request.resource.data.bonusCents) && cent(request.resource.data.deductionCents) &&
       cent(request.resource.data.grossCents) && cent(request.resource.data.netCents) &&
       cent(request.resource.data.get('commissionCents',0)) &&
       request.resource.data.get('taxRateBasisPoints',0) is int &&
       request.resource.data.get('taxRateBasisPoints',0) >= 0 &&
       request.resource.data.get('taxRateBasisPoints',0) <= 10000 &&
       cent(request.resource.data.get('taxCents',0)) &&
       request.resource.data.get('taxCents',0) ==
        math.round(request.resource.data.grossCents * request.resource.data.get('taxRateBasisPoints',0) / 10000) &&
       cent(request.resource.data.get('otherDeductionCents',request.resource.data.deductionCents)) &&
       request.resource.data.get('otherDeductionCents',request.resource.data.deductionCents) +
        request.resource.data.get('taxCents',0) == request.resource.data.deductionCents &&
       request.resource.data.grossCents == request.resource.data.regularCents +
        request.resource.data.overtimeCents + request.resource.data.bonusCents +
        request.resource.data.get('commissionCents',0) &&
       request.resource.data.netCents == request.resource.data.grossCents - request.resource.data.deductionCents && validModeLine(t,r))
      ||
      (owner() && get(runPath(t,r)).data.status == 'finalized' &&
       validRevision(t,r,'line',employeeId) &&
       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'regularHours','overtimeHours','regularCents','overtimeCents','bonusCents',
        'deductionCents','grossCents','netCents','commissionCents','lastRevisionId','lastCorrectedBy','lastCorrectedAt']) &&
       hours(request.resource.data.regularHours) && hours(request.resource.data.overtimeHours) &&
       cent(request.resource.data.regularCents) && cent(request.resource.data.overtimeCents) &&
       cent(request.resource.data.bonusCents) && cent(request.resource.data.deductionCents) &&
       cent(request.resource.data.grossCents) && cent(request.resource.data.netCents) &&
       request.resource.data.grossCents == request.resource.data.regularCents +
        request.resource.data.overtimeCents + request.resource.data.bonusCents +
        request.resource.data.get('commissionCents',0) &&
       request.resource.data.netCents == request.resource.data.grossCents - request.resource.data.deductionCents &&
       request.resource.data.lastCorrectedBy == request.auth.uid &&
       request.resource.data.lastCorrectedAt == request.time && validModeLine(t,r))
     );
     allow delete: if owner() || (payrollStaff(t) && exists(runPath(t,r)) &&
       get(runPath(t,r)).data.status == 'draft');
    }
   }
   match /{other=**} {allow read,write: if false;}
  }
  match /{other=**} {allow read,write: if false;}
 }
}
