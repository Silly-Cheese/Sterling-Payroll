        request.resource.data.submittedBy == '' && request.resource.data.approvedBy == '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','submittedBy','approvedBy']))
       ||
       (owner() && validRevision(t,r,'period',r) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
         'periodStart','periodEnd','payDate','status','submittedBy','approvedBy','finalizedBy','lastRevisionId','lastCorrectedBy','lastCorrectedAt']) &&
