    allow list: if sterlingSupport() ||
     (clientView(t) && resource.data.createdBy == request.auth.uid);
    allow create: if clientHelpDesk(t) &&
     request.resource.data.keys().hasOnly(['type','subject','details','status','createdBy','createdAt','updatedBy','response']) &&
     request.resource.data.type in ['payroll-correction','employee-access','billing','general'] &&
