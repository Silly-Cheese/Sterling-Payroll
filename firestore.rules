   match /timeEntries/{id} {
    allow read: if clientView(t);
    allow create: if payrollStaff(t) &&
     request.resource.data.keys().hasOnly(['employeeId','workDate','regularHours','overtimeHours','note','createdAt','createdBy','status','approvedBy']) &&
     text(request.resource.data.employeeId,128) &&
